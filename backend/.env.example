# backend/.env.example
# Copy to .env and fill in real values. The real .env is gitignored.

NODE_ENV=development
PORT=3000

# --- Core services ---
DATABASE_URL=postgresql://ridehail:secret@localhost:5432/ridehail
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-32-char-random-string

# --- Local OSRM (Los Angeles) ---
# Base URL of the local OSRM osrm-routed sidecar. Defaults to localhost:5000.
OSRM_BASE_URL=http://localhost:5000
# Per-request timeout to the local OSRM engine (ms).
OSRM_TIMEOUT_MS=5000
# Path to the pre-processed OSRM road network (.osrm family).
OSRM_DATA_PATH=./data/LosAngeles.osrm

# --- Fallback: Mapbox Directions API (for areas outside LA region) ---
# Access token from https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=
# Routing profile: 'driving' (standard) or 'driving-traffic' (premium)
MAPBOX_PROFILE=driving
# Request timeout in milliseconds
MAPBOX_TIMEOUT_MS=8000

# --- Matching ---
DRIVER_MATCH_RADIUS_KM=5
DRIVER_ACCEPT_TIMEOUT_MS=15000
DRIVER_PICKUP_PROXIMITY_M=15
DRIVER_DESTINATION_PROXIMITY_M=30
DISPATCH_FANOUT_SIZE=5
MATCH_WORKER_CONCURRENCY=4
DRIVER_SCORE_CACHE_TTL_S=300

# --- Face verification ---
FACE_SERVICE_URL=http://localhost:8000
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_MOTION_PX=15
FACE_MIN_BLINK_COUNT=1
FACE_MIN_LAPLACIAN_VAR=80
FACE_CHECK_INTERVAL_HOURS=12
FACE_LOCATION_JUMP_MILES=5

# --- Navigation & safety ---
SPEEDING_VIOLATION_DURATION_S=45
SPEEDING_DANGER_TRIP_COUNT=3
SPEEDING_WINDOW_DAYS=90
NAV_OFFROUTE_THRESHOLD_M=60
SPEEDING_OFFROUTE_CONSECUTIVE_TICKS=3

# --- Observability (NEW in 100k-scale plan, Step 1) ---
# pino log level: trace|debug|info|warn|error|fatal|silent
PINO_LOG_LEVEL=info
# Sentry DSN for server error tracking. Leave unset to disable.
# SENTRY_DSN=https://...@sentry.io/...
# When set, app version is read from the GIT_SHA env var (set by CI).
GIT_SHA=dev

# --- Google Maps / Gmail / Twilio (existing) ---
GOOGLE_MAPS_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
EMAIL_FROM=NetRide <noreply@netride.com>
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
