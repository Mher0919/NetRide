# ---------------------------------------------------------------------------
# Netride backend — example environment
#
# Copy to backend/.env and fill in real values. NEVER commit .env or any key.
# ---------------------------------------------------------------------------

# Required (the backend refuses to boot without these)
DATABASE_URL=postgres://user:password@host:5432/netride
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://127.0.0.1:6379

# ---- Google Places API (New) — SPECIALS business information --------------
# Server-side only. The key is never sent to rider/admin clients.
#
# Enable in Google Cloud Console for the key's project:
#   1. "Places API (New)"  → business nearby search, text search,
#                            place details and place photos.
#   2. Billing (Places API calls are billed per request/SKU).
#
# Key restrictions (mandatory in production):
#   * Application restriction: None / IP addresses (server) — never a
#     browser HTTP-referrer key and never an Android/iOS app key.
#   * API restriction: restrict the key to "Places API (New)" (add the
#     routing APIs only if this same key is intentionally shared).
#
# Optional. When unset the backend falls back to GOOGLE_MAPS_API_KEY and
# then GOOGLE_ROUTES_API_KEY.
GOOGLE_PLACES_API_KEY=

# Existing Google keys (routing / geospatial features). The Google Places
# proxy may reuse them as fallbacks — see above.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=

# ---------------------------------------------------------------------------
# Stripe (Connect: separate charges and transfers) -- optional
# ---------------------------------------------------------------------------
# Use TEST keys (sk_test_... / pk_test_...) from the Stripe Dashboard for
# development. Never commit live keys.
#
# When STRIPE_SECRET_KEY is unset every Stripe path degrades to the legacy
# wallet rail; nothing is faked and no payment is recorded.
#
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx          # from `stripe listen` or Dashboard
# STRIPE_CONNECT_CLIENT_ID=ca_xxx          # optional (OAuth only; not needed for Express onboarding)
#
# Hard interlock: live keys are REFUSED unless STRIPE_ALLOW_LIVE=true AND
# NODE_ENV=production.
# STRIPE_ALLOW_LIVE=false
#
# STRIPE_CURRENCY=usd
# PUBLIC_BACKEND_URL=http://localhost:3000
# MOBILE_PAYMENT_RETURN_URL=netride://payments/return
