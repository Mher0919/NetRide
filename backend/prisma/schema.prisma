generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL") // optional — overrides for writes
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN

  @@map("user_role")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  BLOCKED

  @@map("verification_status")
}

enum BackgroundCheckStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("background_check_status")
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum ComplianceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("compliance_status")
}

enum VehicleCategory {
  ECONOMY
  EXTRA
  PREMIUM
  LUX
  SUV
  SUV_LUX
  VAN
  PREMIER

  @@map("vehicle_category")
}

enum VehicleClass {
  CORE
  ELITE
  PRESTIGE

  @@map("vehicle_class")
}

model User {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  role                UserRole
  email               String              @unique
  phone_number        String?             @unique
  full_name           String
  password_hash       String?
  date_of_birth       DateTime?           @db.Timestamptz(6)
  profile_image_url   String?
  id_photo_front_url  String?
  id_photo_back_url   String?
  is_verified         Boolean?            @default(false)
  verification_status VerificationStatus? @default(PENDING)
  is_active           Boolean?            @default(true)
  rating              Float?              @default(5.0)
  rating_count        Int?                @default(0)
  password_changed_at DateTime?           @default(now()) @db.Timestamptz(6)

  rejection_reason           String?
  blocked_reason             String?
  verification_feedback_seen Boolean? @default(false)

  onboarding_step   Int?
  phone_verified    Boolean? @default(false)
  headshot_uploaded Boolean? @default(false)
  fcm_token         String?

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  driver_profile    Driver?
  rides_as_rider    Ride[]           @relation("RiderRides")
  rides_as_driver   Ride[]           @relation("DriverRides")
  admin_actions     AuditLog[]       @relation("AdminActions")
  audit_logs_target AuditLog[]       @relation("TargetLogs")
  favorite_drivers  FavoriteDriver[] @relation("RiderFavorites")

  profile_changes  ProfileChangeRequest[] @relation("DriverProfileChanges")
  reviewed_changes ProfileChangeRequest[] @relation("AdminProfileReviews")
  payout_cards     PayoutCard[]           @relation("DriverPayoutCards")
  wallet           DriverWallet?          @relation("DriverWallet")
  payouts          Payout[]               @relation("DriverPayouts")
  ride_preferences DriverRidePreference[] @relation("DriverRidePreferences")

  ride_credit_account   RideCreditAccount?     @relation("RideCreditAccount")
  credit_transactions   CreditTransaction[]    @relation("CreditTransactions")
  rider_wallet          RiderWallet?           @relation("RiderWallet")
  wallet_transactions   WalletTransaction[]    @relation("WalletTransactions")
  referral_code         ReferralCode?          @relation("ReferralCodeOwner")
  referrals_as_referrer ReferralRelationship[] @relation("ReferrerLinks")
  referred_as_user      ReferralRelationship?  @relation("ReferredUser")
  audit_events_actor    AuditEvent[]           @relation("AuditEventActor")

  referral_onboarding_state String?
  device_risk_state         String   @default("NORMAL")
  devices                   UserDevice[]

  reports_filed     RideReport[] @relation("ReportsFiled")
  reports_against   RideReport[] @relation("ReportsAgainst")

  @@map("users")
}

model Driver {
  user_id                 String                 @id @db.Uuid
  license_number          String?
  license_expiry_date     DateTime?              @db.Timestamptz(6)
  license_photo_url       String?
  license_photo_back_url  String?
  insurance_photo_url     String?
  registration_photo_url  String?
  background_check_status BackgroundCheckStatus? @default(PENDING)
  rating                  Decimal?               @default(5.00) @db.Decimal(3, 2)
  total_rides             Int?                   @default(0)
  is_active               Boolean?               @default(false)

  active_class         VehicleClass? @default(CORE)
  cancellation_count   Int?          @default(0)
  acceptance_count     Int?          @default(0)
  last_cancellation_at DateTime?     @db.Timestamptz(6)

  rejection_reason           String?
  verification_feedback_seen Boolean? @default(false)

  price_per_mile     Decimal?  @db.Decimal(10, 2)
  price_range_min    Decimal?  @db.Decimal(10, 2)
  price_range_max    Decimal?  @db.Decimal(10, 2)
  recommended_price  Decimal?  @db.Decimal(10, 2)
  price_last_changed DateTime? @db.Timestamptz(6)
  is_dangerous       Boolean?  @default(false)
  is_flagged         Boolean?  @default(false)
  fcm_token          String?

  // --- 041: fleet partner assignment (nullable = platform direct) ---
  fleet_id String? @db.Uuid

  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vehicles     DriverVehicle[]
  favorited_by FavoriteDriver[] @relation("DriverFavorited")
  fleet        FleetPartner?    @relation(fields: [fleet_id], references: [id], onDelete: SetNull)

  @@index([is_active, active_class])
  @@index([fleet_id])
  @@map("drivers")
}

model FavoriteDriver {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rider_id   String    @db.Uuid
  driver_id  String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  rider  User   @relation("RiderFavorites", fields: [rider_id], references: [id], onDelete: Cascade)
  driver Driver @relation("DriverFavorited", fields: [driver_id], references: [user_id], onDelete: Cascade)

  @@unique([rider_id, driver_id])
  @@map("favorite_drivers")
}

model Vehicle {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  make          String
  model         String
  year          Int
  category      VehicleCategory
  service_class VehicleClass?   @default(CORE)

  drivers DriverVehicle[]

  @@map("vehicles")
}

model DriverVehicle {
  id                      String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driver_id               String?  @db.Uuid
  vehicle_id              String?  @db.Uuid
  license_plate_number    String
  license_plate_photo_url String?
  car_photo_urls          String[]
  make                    String?
  model                   String?
  year                    Int?
  color                   String?
  interior_color          String?
  license_plate_state     String?
  zip_code                String?

  // --- Vehicle classification (derived, not user-selected) ---
  // Verified vehicle class computed by the centralized eligibility engine.
  service_class VehicleClass? @default(CORE)
  // Verified attributes used to derive service_class.
  seats         Int?
  is_luxury     Boolean?      @default(false)

  inspection_photo_url   String?
  inspection_expiry_date DateTime?         @db.Timestamptz(6)
  inspection_status      ComplianceStatus? @default(PENDING)
  inspection_notes       String?

  driver  Driver?  @relation(fields: [driver_id], references: [user_id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@index([service_class])
  @@map("driver_vehicles")
}

// Driver ride-type preferences (which ELIGIBLE ride types they opted into).
// Stored as one row per (driver, ride_type) so future ride categories require
// zero schema changes — just new rows. Preferences are independent of the
// vehicle's eligibility (which is derived) and of the driver's currently
// selected active_class.
model DriverRidePreference {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driver_id  String       @db.Uuid
  ride_type  VehicleClass
  enabled    Boolean      @default(true)
  updated_at DateTime?    @default(now()) @db.Timestamptz(6)

  driver User @relation("DriverRidePreferences", fields: [driver_id], references: [id], onDelete: Cascade)

  @@unique([driver_id, ride_type])
  @@index([driver_id])
  @@map("driver_ride_preferences")
}

model AuditLog {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_id   String    @db.Uuid
  target_id  String    @db.Uuid
  action     String
  details    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  admin  User @relation("AdminActions", fields: [admin_id], references: [id], onDelete: Cascade)
  target User @relation("TargetLogs", fields: [target_id], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Ride {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rider_id              String?       @db.Uuid
  driver_id             String?       @db.Uuid
  status                TripStatus?   @default(REQUESTED)
  requested_class       VehicleClass? @default(CORE)
  snapshot_rider_rating Decimal?      @db.Decimal(3, 2)
  compliance_snapshot   Json?         @default("{}")
  idempotency_key       String?       @unique

  pickup_lat          Float?
  pickup_lng          Float?
  pickup_address      String?
  destination_lat     Float?
  destination_lng     Float?
  destination_address String?

  accepted_at  DateTime? @db.Timestamptz(6)
  started_at   DateTime? @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  cancelled_at DateTime? @db.Timestamptz(6)

  scheduled_at DateTime? @db.Timestamptz(6)
  is_scheduled Boolean?  @default(false)
  tip_amount   Decimal?  @default(0) @db.Decimal(10, 2)

  distance_meters   Int?
  duration_seconds  Int?
  fare_amount       Decimal? @db.Decimal(10, 2)
  initial_max_fare  Decimal? @db.Decimal(10, 2)
  saving_likelihood Int?
  trajectory        Json?    @default("[]")

  estimated_distance_meters  Int?
  estimated_duration_seconds Int?

  // --- 037: Promo + credits applied to this ride (fare_amount stays GROSS) ---
  promo_id              String?   @db.Uuid
  promo_code            String?
  promo_discount_cents  BigInt?   @default(0)
  credits_applied_cents BigInt?   @default(0)
  final_payment_cents   BigInt?   @default(0)
  credits_refunded_at   DateTime? @db.Timestamptz(6)

  // --- 039: Rider wallet payment for this ride ---
  wallet_payment_cents BigInt?   @default(0)
  wallet_refunded_at   DateTime? @db.Timestamptz(6)

  // --- 042: Cancellation audit trail (who cancelled and why) ---
  cancelled_by            String?   @db.Uuid
  cancellation_reason_code String?
  cancellation_reason_text String?

  created_at DateTime? @default(now()) @db.Timestamptz(6)

  rider          User?              @relation("RiderRides", fields: [rider_id], references: [id])
  driver         User?              @relation("DriverRides", fields: [driver_id], references: [id])
  rating         Rating?
  payouts        Payout[]           @relation("RidePayouts")
  price_snapshot RidePriceSnapshot?
  reports        RideReport[]

  promo        PromoCode?          @relation(fields: [promo_id], references: [id], onDelete: SetNull)
  promo_usages PromoUsage[]        @relation("RidePromoUsages")
  credit_tx    CreditTransaction[] @relation("CreditTxRide")
  wallet_tx    WalletTransaction[] @relation("WalletTxRide")
  commission   PartnerCommission?  @relation("CommissionRide")

  @@index([status, created_at(sort: Desc)])
  @@index([rider_id, created_at(sort: Desc)])
  @@index([driver_id, created_at(sort: Desc)])
  @@map("rides")
}

/// 042: Post-ride party reports. Both ride parties may independently file
/// a report against the other party after a terminal ride (CANCELLED or
/// COMPLETED), regardless of who cancelled. One report per (ride, reporter).
model RideReport {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ride_id           String    @db.Uuid
  reporter_id       String    @db.Uuid
  reported_user_id  String    @db.Uuid
  reported_role     String
  reason_code       String
  reason_text       String?
  description       String
  status            String    @default("OPEN")
  resolution_action String?
  admin_notes       String?
  resolved_by       String?   @db.Uuid
  resolved_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)

  ride     Ride  @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  reporter User  @relation("ReportsFiled", fields: [reporter_id], references: [id])
  reported User  @relation("ReportsAgainst", fields: [reported_user_id], references: [id])

  @@unique([ride_id, reporter_id])
  @@index([status, created_at(sort: Desc)])
  @@index([reported_user_id])
  @@map("ride_reports")
}

// ---------------------------------------------------------------------------
// Platform pricing (035): config singleton + per-ride price snapshots.
// The quoted fare at request time is the fare charged at accept time.
// ---------------------------------------------------------------------------

/// 036: Named pricing profiles. The engine is profile-agnostic — each ride
/// category (code) is a row here, with PREMIUM currently live. Legacy
/// singleton retained alongside for historical snapshot compatibility.
model PricingProfile {
  code                  String   @id
  label                 String
  base_fare             Decimal  @default(4.00) @db.Decimal(10, 2)
  per_mile_rate         Decimal  @default(2.50) @db.Decimal(10, 2)
  per_minute_rate       Decimal  @default(0.40) @db.Decimal(10, 2)
  minimum_fare          Decimal  @default(10.00) @db.Decimal(10, 2)
  booking_fee           Decimal  @default(0.00) @db.Decimal(10, 2)
  service_fee_rate      Decimal  @default(0.0000) @db.Decimal(5, 4)
  tax_rate              Decimal  @default(0.0000) @db.Decimal(5, 4)
  max_demand_multiplier Decimal  @default(1.00) @db.Decimal(4, 2)
  peak_time_multiplier  Decimal  @default(1.00) @db.Decimal(4, 2)
  off_peak_multiplier   Decimal  @default(1.00) @db.Decimal(4, 2)
  weather_multiplier    Decimal  @default(1.00) @db.Decimal(4, 2)
  location_multiplier   Decimal  @default(1.00) @db.Decimal(4, 2)
  fleet_multiplier      Decimal  @default(1.00) @db.Decimal(4, 2)
  active                Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  @@map("pricing_profiles")
}

model PricingConfiguration {
  id                    Int      @id @default(1)
  base_fare             Decimal  @default(3.50) @db.Decimal(8, 2)
  per_km_rate           Decimal  @default(1.50) @db.Decimal(8, 2)
  per_minute_rate       Decimal  @default(0.35) @db.Decimal(8, 2)
  minimum_fare          Decimal  @default(7.00) @db.Decimal(8, 2)
  booking_fee           Decimal  @default(1.50) @db.Decimal(8, 2)
  service_fee_rate      Decimal  @default(0.10) @db.Decimal(5, 4)
  tax_rate              Decimal  @default(0.0875) @db.Decimal(5, 4)
  max_demand_multiplier Decimal  @default(2.00) @db.Decimal(4, 2)
  peak_time_multiplier  Decimal  @default(1.25) @db.Decimal(4, 2)
  off_peak_multiplier   Decimal  @default(0.95) @db.Decimal(4, 2)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  @@map("pricing_configurations")
}

model RidePriceSnapshot {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ride_id              String   @unique @db.Uuid
  distance_km          Decimal  @db.Decimal(10, 3)
  duration_minutes     Decimal  @db.Decimal(10, 2)
  multiplier_breakdown Json     @default("{}")
  config               Json     @default("{}")
  final_fare           Decimal  @db.Decimal(10, 2)
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  // --- 041: per-ride revenue allocation (cent-exact reconciliation) ---
  driver_share_cents      BigInt?
  platform_share_cents    BigInt?
  netride_share_cents     BigInt?
  fleet_allocations       Json     @default("[]")
  driver_fleet_id         String?  @db.Uuid
  revenue_config_snapshot Json     @default("{}")

  ride Ride @relation(fields: [ride_id], references: [id], onDelete: Cascade)

  @@index([ride_id])
  @@map("ride_price_snapshots")
}

/// 041: Fleet partners earn a configured % of the 40% platform revenue pool
/// on rides completed by their assigned drivers. NetRide keeps the remainder.
model FleetPartner {
  id                     String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                   String
  contact_name           String?
  contact_email          String?
  platform_share_percent Decimal    @default(0) @db.Decimal(5, 2)
  is_active              Boolean    @default(true)
  notes                  String?
  created_at             DateTime   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime   @default(now()) @db.Timestamptz(6)

  drivers Driver[]

  @@index([is_active])
  @@map("fleet_partners")
}

/// 041: Global revenue split singleton (id = 1). Currently locked at
/// 60% driver / 40% platform. Sum must always equal 100.
model RevenueConfig {
  id                     Int      @id @default(1)
  driver_share_percent   Decimal  @default(60.00) @db.Decimal(5, 2)
  platform_share_percent Decimal  @default(40.00) @db.Decimal(5, 2)
  updated_at             DateTime @default(now()) @db.Timestamptz(6)

  @@map("revenue_configs")
}

model Rating {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ride_id            String    @unique @db.Uuid
  rater_id           String    @db.Uuid
  target_id          String    @db.Uuid
  target_role        UserRole
  rating             Int
  review_text        String?
  flagged_for_review Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  ride Ride @relation(fields: [ride_id], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model VehicleModel {
  id    String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  make  String
  model String
  year  Int

  @@unique([make, model, year])
  @@map("vehicle_models")
}

// ---------- 020: Profile-change approval + wallet + payouts ---------------

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("profile_change_status")
}

enum PayoutCardStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("payout_card_status")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED

  @@map("payout_status")
}

enum PayoutMethod {
  WEEKLY_AUTO
  ON_DEMAND
  RIDE_CREDIT

  @@map("payout_method")
}

enum CardBrand {
  visa
  mastercard
  amex
  discover
  unknown

  @@map("card_brand")
}

model ProfileChangeRequest {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driver_id            String                 @db.Uuid
  requested_changes    Json
  status               ProfileChangeStatus    @default(PENDING)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  reviewed_at          DateTime?              @db.Timestamptz(6)
  reviewed_by_admin_id String?                @db.Uuid
  rejection_reason     String?
  card_last4           String?
  card_brand           CardBrand?
  prev_is_active       Boolean?
  prev_bg_status       BackgroundCheckStatus?

  driver   User  @relation("DriverProfileChanges", fields: [driver_id], references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminProfileReviews", fields: [reviewed_by_admin_id], references: [id], onDelete: SetNull)

  @@index([status, created_at(sort: Desc)])
  @@index([driver_id, created_at(sort: Desc)])
  @@map("profile_change_requests")
}

model PayoutCard {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driver_id        String           @db.Uuid
  brand            CardBrand
  last4            String           @db.Char(4)
  exp_month        Int
  exp_year         Int
  cardholder_name  String
  zip              String
  status           PayoutCardStatus @default(PENDING)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  approved_at      DateTime?        @db.Timestamptz(6)
  rejected_at      DateTime?        @db.Timestamptz(6)
  rejection_reason String?

  driver  User           @relation("DriverPayoutCards", fields: [driver_id], references: [id], onDelete: Cascade)
  wallets DriverWallet[] @relation("WalletCard")

  @@index([driver_id, status])
  @@index([status, created_at(sort: Desc)])
  @@map("payout_cards")
}

model DriverWallet {
  driver_id               String    @id @db.Uuid
  balance_cents           BigInt    @default(0)
  lifetime_earnings_cents BigInt    @default(0)
  payout_card_id          String?   @db.Uuid
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  driver      User        @relation("DriverWallet", fields: [driver_id], references: [id], onDelete: Cascade)
  payout_card PayoutCard? @relation("WalletCard", fields: [payout_card_id], references: [id], onDelete: SetNull)

  @@map("driver_wallets")
}

model Payout {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driver_id    String       @db.Uuid
  amount_cents BigInt
  fee_cents    BigInt       @default(0)
  net_cents    BigInt
  status       PayoutStatus @default(PENDING)
  method       PayoutMethod
  ride_id      String?      @db.Uuid
  requested_at DateTime?    @default(now()) @db.Timestamptz(6)
  processed_at DateTime?    @db.Timestamptz(6)
  reference    String?
  notes        String?

  driver User  @relation("DriverPayouts", fields: [driver_id], references: [id], onDelete: Cascade)
  ride   Ride? @relation("RidePayouts", fields: [ride_id], references: [id], onDelete: SetNull)

  @@index([driver_id, status, requested_at(sort: Desc)])
  @@index([status, requested_at(sort: Desc)])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// 037: Partner + promo + referral + ride credits ecosystem
// ---------------------------------------------------------------------------

model Partner {
  id                      String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                    String
  business_type           String
  address                 String?
  contact_name            String?
  contact_phone           String?
  contact_email           String?
  commission_rate         Decimal  @default(0.10) @db.Decimal(5, 4)
  status                  String   @default("ACTIVE")
  lifetime_earnings_cents BigInt   @default(0)
  pending_earnings_cents  BigInt   @default(0)
  paid_earnings_cents     BigInt   @default(0)
  total_referred_rides    BigInt   @default(0)
  notes                   String?
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)

  promos      PromoCode[]
  commissions PartnerCommission[]

  @@index([status])
  @@map("partners")
}

model PromoCode {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code                 String    @unique
  partner_id           String?   @db.Uuid
  discount_type        String
  discount_value       Decimal   @db.Decimal(10, 2)
  max_uses             Int       @default(0)
  times_used           Int       @default(0)
  expires_at           DateTime? @db.Timestamptz(6)
  active               Boolean   @default(true)
  min_ride_fare_cents  BigInt    @default(0)
  max_discount_cents   BigInt    @default(0)
  single_use_per_rider Boolean   @default(true)
  usage_rule           String    @default("STANDARD")
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)

  partner     Partner?            @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  usages      PromoUsage[]
  commissions PartnerCommission[]
  rides       Ride[]

  @@index([partner_id])
  @@map("promo_codes")
}

model PromoUsage {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  promo_id         String    @db.Uuid
  ride_id          String    @db.Uuid
  rider_id         String    @db.Uuid
  discount_cents   BigInt
  rider_paid_cents BigInt    @default(0)
  status           String    @default("APPLIED")
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  completed_at     DateTime? @db.Timestamptz(6)

  promo PromoCode @relation(fields: [promo_id], references: [id], onDelete: Cascade)
  ride  Ride      @relation("RidePromoUsages", fields: [ride_id], references: [id], onDelete: Cascade)

  @@index([promo_id, status])
  @@index([rider_id, created_at(sort: Desc)])
  @@map("promo_usage")
}

model RideCreditAccount {
  user_id               String   @id @db.Uuid
  balance_cents         BigInt   @default(0)
  lifetime_earned_cents BigInt   @default(0)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  user User @relation("RideCreditAccount", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("ride_credit_accounts")
}

model CreditTransaction {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String   @db.Uuid
  amount_cents        BigInt
  type                String
  reference_type      String?
  reference_id        String?  @db.Uuid
  ride_id             String?  @db.Uuid
  description         String?
  balance_after_cents BigInt
  idempotency_key     String?  @unique
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  user User  @relation("CreditTransactions", fields: [user_id], references: [id], onDelete: Cascade)
  ride Ride? @relation("CreditTxRide", fields: [ride_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)])
  @@index([type])
  @@map("credit_transactions")
}

model RiderWallet {
  user_id                 String   @id @db.Uuid
  balance_cents           BigInt   @default(0)
  lifetime_deposited_cents BigInt  @default(0)
  lifetime_spent_cents    BigInt   @default(0)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)

  user User @relation("RiderWallet", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("rider_wallets")
}

model WalletTransaction {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String   @db.Uuid
  amount_cents        BigInt
  type                String
  reference_type      String?
  reference_id        String?  @db.Uuid
  ride_id             String?  @db.Uuid
  description         String?
  balance_after_cents BigInt
  idempotency_key     String?  @unique
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  user User  @relation("WalletTransactions", fields: [user_id], references: [id], onDelete: Cascade)
  ride Ride? @relation("WalletTxRide", fields: [ride_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)])
  @@index([type])
  @@map("wallet_transactions")
}

model PartnerCommission {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  partner_id       String    @db.Uuid
  ride_id          String    @unique @db.Uuid
  promo_id         String?   @db.Uuid
  promo_code       String
  ride_price_cents BigInt
  commission_rate  Decimal   @db.Decimal(5, 4)
  commission_cents BigInt
  status           String    @default("PENDING")
  paid_at          DateTime? @db.Timestamptz(6)
  paid_reference   String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  partner Partner    @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  ride    Ride       @relation("CommissionRide", fields: [ride_id], references: [id], onDelete: Cascade)
  promo   PromoCode? @relation(fields: [promo_id], references: [id], onDelete: SetNull)

  @@index([partner_id, status])
  @@index([created_at(sort: Desc)])
  @@map("partner_commissions")
}

model ReferralCode {
  user_id    String   @id @db.Uuid
  code       String   @unique
  qr_payload String
  issued_at  DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  user User @relation("ReferralCodeOwner", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("referral_codes")
}

model ReferralRelationship {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  referrer_id             String    @db.Uuid
  referred_user_id        String    @unique @db.Uuid
  status                  String    @default("LINKED")
  scanned_at              DateTime  @default(now()) @db.Timestamptz(6)
  first_ride_id           String?   @db.Uuid
  first_ride_completed_at DateTime? @db.Timestamptz(6)
  reward_granted_at       DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  referrer User @relation("ReferrerLinks", fields: [referrer_id], references: [id], onDelete: Cascade)
  referred User @relation("ReferredUser", fields: [referred_user_id], references: [id], onDelete: Cascade)

  @@index([referrer_id, created_at(sort: Desc)])
  @@map("referral_relationships")
}

model ReferralReward {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  relationship_id  String   @unique @db.Uuid
  referrer_id      String   @db.Uuid
  referred_user_id String   @db.Uuid
  ride_id          String   @db.Uuid
  amount_cents     BigInt   @default(500)
  referrer_tx_id   String?  @db.Uuid
  referred_tx_id   String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([referrer_id, created_at(sort: Desc)])
  @@map("referral_rewards")
}

model AuditEvent {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actor_id    String?  @db.Uuid
  actor_role  String?
  action      String
  entity_type String
  entity_id   String?
  details     Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditEventActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([created_at(sort: Desc)])
  @@map("audit_events")
}

model UserDevice {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String   @db.Uuid
  device_id    String
  platform     String?
  device_model String?
  app_version  String?
  first_seen_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@index([device_id])
  @@map("user_devices")
}
