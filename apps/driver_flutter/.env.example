# Copy to .env for local development. Never commit the real .env.
# Supabase project (URL + anon key are client-side public values, but keep
# them out of the repo so environments can differ).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth client IDs.
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# NetRide backend API base URL (no trailing slash).
API_BASE_URL=https://your-backend.example.com
